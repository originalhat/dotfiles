# <paper>
# This section is automatically generated by init.sh in the paper repo.
# Anything placed between the <paper> tags will be overwritten by said script.
source /etc/profile # we need to populate PATH env var - https://stackoverflow.com/a/34244862

export PAPER_DIR="/Users/devin/workspace/paper"

for fn_file in ${PAPER_DIR}/scripts/cli-commands/*(.); do
  # fn is everything after the last / in the path
  fn="${fn_file##*/}"

  if ! type "${fn}" > /dev/null; then
    alias "${fn}"="${PAPER_DIR}/scripts/cli-commands/${fn}"
  fi
done

function do_paper_chpwd_functions {
  local fn_file=""
  for fn_file in ${PAPER_DIR}/scripts/chpwd_functions/*(.); do
    source "${fn_file}"
  done
}

chpwd_functions+=( do_paper_chpwd_functions )
do_paper_chpwd_functions

unset fn
unset fn_file
# </paper>
# Agent tool shells run zsh non-interactively with bare_glob_qual off; paper's chpwd glob fails there and aborts the command.
[[ -o interactive ]] || chpwd_functions=(${chpwd_functions:#do_paper_chpwd_functions})
. "$HOME/.cargo/env"
# Agent tool shells run zsh non-interactively and write bash: `echo ====` trips EQUALS expansion, `--include=*.rb` trips NOMATCH.
[[ -o interactive ]] || unsetopt EQUALS NOMATCH
